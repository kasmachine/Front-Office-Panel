rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read, write for Front Office Panel collections
    match /cash_counts/{id} {
      allow read, write: if true;
    }

    match /receipt_substitutes/{id} {
      allow read, write: if true;
    }

    match /front_office_sops/{id} {
      allow read, write: if true;
    }

    match /active_drafts/{id} {
      allow read, write: if true;
    }

    match /test/{id} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

